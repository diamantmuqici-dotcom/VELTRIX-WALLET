  },
  "devDependencies": {
    "@types/big.js": "7.0.0",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "4.7.0",
    "fast-check": "4.10.2",
    "typescript": "5.8.3",
    "vite": "6.3.7",
    "vitest": "3.2.7"
  }
}
